# Reference only — each service application.yml uses these defaults for local pgAdmin.
# Server: PostgreSQL 17 @ localhost:5432  |  Database: order-ms  |  User: postgres
#
# spring.datasource.url: jdbc:postgresql://localhost:5432/order-ms
# spring.datasource.username: postgres
# spring.datasource.password: (set in each service application.yml / OMS_DB_PASSWORD)
# spring.datasource.driver-class-name: org.postgresql.Driver
#
# Override at runtime if needed:
#   OMS_DB_URL=jdbc:postgresql://localhost:5432/order-ms
#   OMS_DB_USER=postgres
#   OMS_DB_PASSWORD=...
#   OMS_DB_DRIVER=org.postgresql.Driver
